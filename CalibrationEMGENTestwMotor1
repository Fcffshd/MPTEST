import RPi.GPIO as GPIO
import time
import serial
import threading
import numpy as np

# =========================
# Pin definitions (BCM)
# =========================
SWITCH_PIN = 27   # 3-prong switch COM -> EN for PID/Motor
BUTTON_PIN = 22   # push button -> Calibration trigger
BUZZER_PIN = 26   # passive buzzer +
SERVO_PIN  = 18   # PWM0 output for servo (GPIO18) [web:1]

# =========================
# Global state
# =========================
Calibration_Flag = False
running = True
pid_enabled = False
thresholds = {
    'MIN_EMG_V': 0.8,
    'MAX_EMG_V': 1.8,
    'PID_KP': 0.20,      # Proportional gain [web:9]
    'PID_KI': 0.05,      # Integral gain
    'PID_KD': 0.05       # Derivative gain
}
smoothed_emg = 0.8  # Global smoothed EMG for filtering [web:34]

# =========================
# Setup GPIO
# =========================
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

# PWM setup
buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()
servo = GPIO.PWM(SERVO_PIN, 50)  # 50Hz for servo [web:3]
servo.start(0)

# EMG UART w/ timeout to prevent blocking [web:21]
ser = serial.Serial('/dev/ttyAMA0', 115200, timeout=0.05)

# =========================
# PID Controller Class (Enhanced)
# =========================
class PID:
    def __init__(self, kp, ki, kd, min_out, max_out):
        self.kp, self.ki, self.kd = kp, ki, kd
        self.min_out, self.max_out = min_out, max_out
        self.reset()

    def reset(self):
        self.prev_error = 0
        self.integral = 0
        self.last_time = time.time()

    def update(self, setpoint, measurement):
        current_time = time.time()
        dt = current_time - self.last_time
        if dt <= 0: return 0
        
        error = setpoint - measurement
        self.integral += error * dt
        
        # Anti-windup: clamp integral [web:9]
        max_i = (self.max_out - self.kp*error - self.kd*(error - self.prev_error)/dt) / self.ki
        self.integral = max(-abs(max_i), min(abs(max_i), self.integral))
        
        P = self.kp * error
        I = self.ki * self.integral
        D = self.kd * (error - self.prev_error) / dt
        
        output = P + I + D
        output = max(self.min_out, min(self.max_out, output))
        
        self.prev_error = error
        self.last_time = current_time
        return output

# Initialize PID
pid_params = {k.replace('PID_', ''): v for k, v in thresholds.items() if k.startswith('PID_')}
pid_controller = PID(pid_params['KP'], pid_params['KI'], pid_params['KD'], 
                     thresholds['MIN_EMG_V'], thresholds['MAX_EMG_V'])

# =========================
# Servo Functions (0-180°)
# =========================
def angle_to_duty(angle):
    angle = max(0, min(180, angle))
    min_duty, max_duty = 2.5, 10.0  # Standard SG90 range [web:1][web:11]
    return min_duty + (max_duty - min_duty) * (angle / 180.0)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# Apply Thresholds to PID
# =========================
def apply_thresholds_to_pid():
    global pid_controller
    pid_controller.min_out = thresholds['MIN_EMG_V']
    pid_controller.max_out = thresholds['MAX_EMG_V']
    pid_controller.kp = thresholds['PID_KP']
    pid_controller.ki = thresholds['PID_KI']
    pid_controller.kd = thresholds['PID_KD']
    pid_controller.reset()
    print(f"✅ PID updated: Kp={thresholds['PID_KP']:.2f}, Ki={thresholds['PID_KI']:.2f}, Kd={thresholds['PID_KD']:.2f}")
    print(f"   EMG range: {thresholds['MIN_EMG_V']:.2f}V → {thresholds['MAX_EMG_V']:.2f}V") [web:20]

# =========================
# Buzzer Melodies
# =========================
NOTE_E5, NOTE_D5, NOTE_FS4, NOTE_GS4 = 659, 587, 370, 415
NOTE_CS5, NOTE_B4, NOTE_D4, NOTE_E4 = 554, 494, 294, 330
NOTE_A4, NOTE_CS4 = 440, 277

melody = [NOTE_E5, NOTE_D5, NOTE_FS4, NOTE_GS4, NOTE_CS5, NOTE_B4, NOTE_D4, NOTE_E4, NOTE_B4, NOTE_A4, NOTE_CS4, NOTE_E4, NOTE_A4]
durations = [8, 8, 4, 4, 8, 8, 4, 4, 8, 8, 4, 4, 2]

def play_note(freq, duration_s):
    if freq <= 0:
        buzzer.stop()
        time.sleep(duration_s)
        return
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration_s * 0.9)
    buzzer.stop()
    time.sleep(duration_s * 0.1)

def play_melody():
    for i, freq in enumerate(melody):
        duration_s = 1000.0 / durations[i] / 1000.0
        play_note(freq, duration_s)

def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

# =========================
# CALIBRATION MODE (Enhanced)
# =========================
def calibration_mode():
    global thresholds, smoothed_emg
    
    print("\n🎯 CALIBRATION MODE ACTIVE (5 seconds)")
    print("Relax muscle completely...")
    
    emg_samples = []
    start_time = time.time()
    
    while time.time() - start_time < 5.0:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith("EMG:"):
                    voltage = float(line.split(":")[1].strip().split()[0])
                    emg_samples.append(voltage)
                    print(f"EMG: {voltage:.2f}V", end="\r")
        except:
            pass
        time.sleep(0.05)
    
    if emg_samples:
        min_emg = np.min(emg_samples)
        max_emg = np.max(emg_samples)  # Assumes clenched during/after relax? Extend for full range
        
        thresholds.update({
            'MIN_EMG_V': max(0.5, min_emg - 0.1),
            'MAX_EMG_V': min(2.5, max_emg + 0.2)
        })
        
        smoothed_emg = thresholds['MIN_EMG_V']
        print(f"\n✅ Calibration complete!")
        print(f"EMG range: {thresholds['MIN_EMG_V']:.2f}V → {thresholds['MAX_EMG_V']:.2f}V")
        apply_thresholds_to_pid()
    else:
        print("⚠️ No EMG data during calibration")

# =========================
# EMG + PID Thread (w/ Smoothing)
# =========================
def emg_pid_thread():
    global running, pid_enabled, smoothed_emg
    
    while running:
        switch_on = GPIO.input(SWITCH_PIN)
        pid_enabled = switch_on
        
        if pid_enabled:
            try:
                if ser.in_waiting > 0:
                    line = ser.readline().decode('utf-8', errors='ignore').strip()
                    if line.startswith("EMG:"):
                        raw_voltage = float(line.split(":")[1].strip().split()[0])
                        
                        # Exponential low-pass filter (alpha=0.1 for EMG) [web:34][web:41]
                        alpha = 0.1
                        smoothed_emg = alpha * raw_voltage + (1 - alpha) * smoothed_emg
                        
                        # PID: track to desired (e.g., max for clenched control) [web:20]
                        adjustment = pid_controller.update(thresholds['MAX_EMG_V'], smoothed_emg)
                        target_voltage = smoothed_emg + adjustment  # PID adjusts tracking voltage
                        
                        # Clamp
                        target_voltage = max(thresholds['MIN_EMG_V'], 
                                          min(thresholds['MAX_EMG_V'], target_voltage))
                        
                        # Map to servo angle
                        angle = int((target_voltage - thresholds['MIN_EMG_V']) / 
                                  (thresholds['MAX_EMG_V'] - thresholds['MIN_EMG_V']) * 180)
                        servo_set_angle(angle)
                        
                        print(f"Raw:{raw_voltage:.2f} Smooth:{smoothed_emg:.2f} Adj:{adjustment:.3f} Angle:{angle}°", end="\r")
                        
            except Exception as e:
                print(f"EMG/PID error: {e}")
        else:
            servo_set_angle(0)
            smoothed_emg = thresholds['MIN_EMG_V']
            pid_controller.reset()
        
        time.sleep(0.01)  # 100Hz loop [web:21]

# =========================
# Main Loop
# =========================
try:
    print("EMG-PID-Servo System v1.4 (Complete)")
    print("Button 22: Calibration | Switch 27: PID EN")
    print("Ctrl+C to exit")
    
    # Start thread
    pid_thread = threading.Thread(target=emg_pid_thread, daemon=True)
    pid_thread.start()
    
    last_button_state = GPIO.input(BUTTON_PIN)
    
    while True:
        button_state = GPIO.input(BUTTON_PIN)
        button_pressed = (button_state == 0)
        switch_state = GPIO.input(SWITCH_PIN)
        
        # Debounced button press
        if last_button_state == 1 and button_state == 0:
            short_beep(0.2, 2000)
            play_melody()
            calibration_mode()
        
        # Status
        status = f"Switch: {'PID ON' if switch_state else 'PID OFF'}, Button: {'CALIB' if button_pressed else 'IDLE'}, PID_EN: {pid_enabled}"
        print(status, end="\r")
        
        last_button_state = button_state
        time.sleep(0.05)

except KeyboardInterrupt:
    print("\nShutting down...")
finally:
    running = False
    time.sleep(0.2)  # Let thread exit
    servo.ChangeDutyCycle(0)
    time.sleep(0.5)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\n✅ System shutdown complete")
