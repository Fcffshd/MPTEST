def apply_thresholds_to_pid():
    """Apply calibration thresholds to PID limits"""
    global pid_controller
    pid_controller.min_out = thresholds['MIN_EMG_V']
    pid_controller.max_out = thresholds['MAX_EMG_V']
    pid_controller.kp = thresholds['PID_KP']
    pid_controller.ki = thresholds['PID_KI']
    pid_controller.kd = thresholds['PID_KD']
    pid_controller.reset()
    print(f"✅ PID updated: Kp={thresholds['PID_KP']:.2f}, Ki={thresholds['PID_KI']:.2f}, Kd={thresholds['PID_KD']:.2f}")
    print(f"   EMG range: {thresholds['MIN_EMG_V']}V → {thresholds['MAX_EMG_V']}V")

