#version 1.3
import serial
import time
import threading
import RPi.GPIO as GPIO

# =========================
# Pins
# =========================
BUTTON_PIN = 22   # push button
BUZZER_PIN = 26   # passive buzzer +

# =========================
# Globals
# =========================
calibrating = False
calibration_start_time = 0
emg_data = []  # stores all EMG values with timestamps during calibration
no_flex_start = 0
calib_complete = False

# Calibration ranges (set after calibration)
NO_FLEX_MIN = 0
NO_FLEX_MAX = 0
MEDIUM_FLEX_MIN = 0
MEDIUM_FLEX_MAX = 0
FULL_FLEX_MIN = 0
FULL_FLEX_MAX = 0

# UART setup
ser = serial.Serial('/dev/ttyAMA0', 115200)

# GPIO setup
GPIO.setmode(GPIO.BCM)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
buzzer = GPIO.PWM(BUZZER_PIN, 2000)
buzzer.stop()

def short_beep(duration=0.2, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

def play_calib_start():
    for _ in range(3):
        short_beep(0.1, 1500)
        time.sleep(0.1)
    time.sleep(0.2)

def play_calib_complete():
    buzzer.ChangeFrequency(1000)
    buzzer.start(50)
    time.sleep(1.0)
    buzzer.stop()

def uart_reader():
    """Background EMG reader"""
    global emg_data, calibrating
    while True:
        try:
            line = ser.readline().decode().strip()
            if line:
                emg_value = float(line)
                current_time = time.time()
                
                if calibrating:
                    emg_data.append((current_time, emg_value))
                
                print(f"EMG: {emg_value:.2f}", end='\r')
        except:
            pass

def process_calibration_ranges():  # ✅ MOVED BEFORE MAIN LOOP
    """Calculate min/max for each phase"""
    global NO_FLEX_MIN, NO_FLEX_MAX, MEDIUM_FLEX_MIN, MEDIUM_FLEX_MAX, FULL_FLEX_MIN, FULL_FLEX_MAX
    
    no_flex_data = [val for ts, val in emg_data if no_flex_start <= ts < no_flex_start + 5]
    medium_data = [val for ts, val in emg_data if no_flex_start + 5 <= ts < no_flex_start + 15]
    full_data = [val for ts, val in emg_data if no_flex_start + 15 <= ts < no_flex_start + 20]
    
    if no_flex_data:
        NO_FLEX_MIN, NO_FLEX_MAX = min(no_flex_data), max(no_flex_data)
    if medium_data:
        MEDIUM_FLEX_MIN, MEDIUM_FLEX_MAX = min(medium_data), max(medium_data)
    if full_data:
        FULL_FLEX_MIN, FULL_FLEX_MAX = min(full_data), max(full_data)
    
    print("\n" + "="*60)
    print("✅ CALIBRATION COMPLETE - THRESHOLDS READY")
    print("="*60)
    print(f"NO_FLEX:     {NO_FLEX_MIN:6.2f} ↔ {NO_FLEX_MAX:6.2f}")
    print(f"MEDIUM_FLEX: {MEDIUM_FLEX_MIN:6.2f} ↔ {MEDIUM_FLEX_MAX:6.2f}")
    print(f"FULL_FLEX:   {FULL_FLEX_MIN:6.2f} ↔ {FULL_FLEX_MAX:6.2f}")
    print("\nClassification:")
    print(f"  emg < {NO_FLEX_MAX:.1f} → NO_FLEX")
    print(f"  emg < {MEDIUM_FLEX_MAX:.1f} → MEDIUM")
    print(f"  else → FULL")
    print("="*60)

# Start EMG thread
threading.Thread(target=uart_reader, daemon=True).start()

try:
    print("🎯 EMG Calibration Ready | Press button for 20s sequence")
    print("📊 0-5s: NO_FLEX | 5-15s: MEDIUM | 15-20s: FULL_FLEX")
    
    button_last_state = 1
    
    while True:
        button_state = GPIO.input(BUTTON_PIN)
        
        if button_last_state == 1 and button_state == 0:
            if not calibrating and not calib_complete:
                # START CALIBRATION
                calibrating = True
                calib_complete = False
                calibration_start_time = time.time()
                emg_data.clear()
                no_flex_start = calibration_start_time
                play_calib_start()
                print("\n🚀 *** CALIBRATION STARTED ***")
                print("   0-5s: RELAX (NO_FLEX)")
                
            elif calib_complete:
                print("\n🔄 Press again to restart calibration")
        
        button_last_state = button_state
        
        if calibrating:
            elapsed = time.time() - calibration_start_time
            
            if elapsed < 5:
                pass  # NO_FLEX
            elif elapsed < 15:
                if elapsed - 5 < 0.1:
                    print("\n   5-15s: MEDIUM FLEX")
            else:
                if elapsed - 15 < 0.1:
                    print("\n   15-20s: FULL FLEX (MAX EFFORT!)")
            
            if elapsed >= 20.0:
                calibrating = False
                calib_complete = True
                play_calib_complete()
                process_calibration_ranges()
        
        time.sleep(0.02)

except KeyboardInterrupt:
    pass
finally:
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\n👋 Exit complete.")
