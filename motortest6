import RPi.GPIO as GPIO
import time

SERVO_PIN = 18

GPIO.setmode(GPIO.BCM)
GPIO.setup(SERVO_PIN, GPIO.OUT)

servo = GPIO.PWM(SERVO_PIN, 50)  # 50 Hz
servo.start(0)
time.sleep(1)

def angle_to_duty(angle):
    # Conservative 0–180° mapping for HS-311
    angle = max(0, min(180, angle))
    pulse_us = 900 + (2100 - 900) * (angle / 180.0)
    return (pulse_us / 20000.0) * 100.0

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)
    time.sleep(0.02)  # small settle delay

try:
    MIN_ANGLE = 0
    MAX_ANGLE = 180  # set to 270 only if your servo genuinely supports 270°

    print("Sweeping slowly from 0° to max and back... Ctrl+C to stop")

    while True:
        # Up: 0 -> MAX
        for angle in range(MIN_ANGLE, MAX_ANGLE + 1, 2):  # step 2° for smoothness
            print(f"\rAngle: {angle}°", end="")
            servo_set_angle(angle)
            time.sleep(0.03)  # speed

        # Down: MAX -> 0
        for angle in range(MAX_ANGLE, MIN_ANGLE - 1, -2):
            print(f"\rAngle: {angle}°", end="")
            servo_set_angle(angle)
            time.sleep(0.03)

except KeyboardInterrupt:
    pass
finally:
    servo.ChangeDutyCycle(0)
    time.sleep(0.5)
    servo.stop()
    GPIO.cleanup()
    print("\nDone")
