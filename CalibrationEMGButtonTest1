#version 1.2

import RPi.GPIO as GPIO
import time
import serial
import threading

# =========================
# Pin definitions (BCM)
# =========================
SWITCH_PIN = 27   # 3‑prong switch COM
BUTTON_PIN = 22   # push button
BUZZER_PIN = 26   # passive buzzer +
SERVO_PIN  = 18   # PWM0 output for servo (GPIO18)

# =========================
# Global state
# =========================
Calibration_Flag = False
running = True

# =========================
# Setup GPIO
# =========================
GPIO.setmode(GPIO.BCM)

GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)  # Switch
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)    # Button (active low)
GPIO.setup(BUZZER_PIN, GPIO.OUT)                             # Buzzer
GPIO.setup(SERVO_PIN, GPIO.OUT)                              # Servo PWM

# Buzzer PWM
buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()

# Servo PWM (50 Hz)
servo = GPIO.PWM(SERVO_PIN, 50)
servo.start(0)

# EMG UART
ser = serial.Serial('/dev/ttyAMA0', 115200)

# =========================
# Buzzer / melody (unchanged)
# =========================
NOTE_E5  = 659
NOTE_D5  = 587
NOTE_FS4 = 370
NOTE_GS4 = 415
NOTE_CS5 = 554
NOTE_B4  = 494
NOTE_D4  = 294
NOTE_E4  = 330
NOTE_A4  = 440
NOTE_CS4 = 277

melody = [NOTE_E5, NOTE_D5, NOTE_FS4, NOTE_GS4, NOTE_CS5, NOTE_B4, NOTE_D4, NOTE_E4, NOTE_B4, NOTE_A4, NOTE_CS4, NOTE_E4, NOTE_A4]
durations = [8, 8, 4, 4, 8, 8, 4, 4, 8, 8, 4, 4, 2]

def play_note(freq, duration_s):
    if freq <= 0:
        buzzer.stop()
        time.sleep(duration_s)
        return
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration_s * 0.9)
    buzzer.stop()
    time.sleep(duration_s * 0.1)

def play_melody():
    for i in range(len(durations)):
        duration_s = (1000.0 / durations[i]) / 1000.0
        play_note(melody[i], duration_s)

def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

# =========================
# Servo 180° (unchanged)
# =========================
def angle_to_duty(angle):
    min_duty = 2.5
    max_duty = 10.0
    angle = max(0, min(180, angle))
    return min_duty + (max_duty - min_duty) * (angle / 180.0)

def servo_set_angle(angle):
    servo.ChangeDutyCycle(angle_to_duty(angle))

# =========================
# EMG reader thread
# =========================
def uart_reader():
    global running
    while running:
        try:
            line = ser.readline().decode().strip()
            if line:
                print("EMG:", line)
        except:
            pass

# =========================
# Servo oscillation thread
# =========================
def servo_oscillator():
    global running
    direction = 1
    angle = 0
    step = 10
    delay = 0.05

    while running:
        if GPIO.input(SWITCH_PIN):
            servo_set_angle(angle)
            time.sleep(delay)
            angle += direction * step
            if angle >= 180:
                angle = 180
                direction = -1
            elif angle <= 0:
                angle = 0
                direction = 1
        else:
            servo_set_angle(0)
            time.sleep(0.1)

# =========================
# Main loop (FIXED - no undefined functions)
# =========================
try:
    print("RPi5: Switch/Servo(0-180°)/Button/Buzzer/EMG ready. Ctrl+C exit.")

    threading.Thread(target=uart_reader, daemon=True).start()
    threading.Thread(target=servo_oscillator, daemon=True).start()

    last_button = GPIO.input(BUTTON_PIN)

    while True:
        switch_on = GPIO.input(SWITCH_PIN)
        button_state = GPIO.input(BUTTON_PIN)
        button_pressed = (button_state == 0)

        # Button press detection
        if last_button == 1 and button_state == 0:
            Calibration_Flag = True
            print(f"\nCALIBRATION TRIGGERED! Flag={Calibration_Flag}")
            short_beep(0.1, 2500)
            play_melody()

        last_button = button_state

        # Live status
        print(f"Switch:{'ON' if switch_on else 'OFF'} Button:{'PRESSED' if button_pressed else 'IDLE'} Flag:{Calibration_Flag}", end='\r')
        time.sleep(0.02)

except KeyboardInterrupt:
    pass
finally:
    running = False
    servo.ChangeDutyCycle(0)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\nShutdown complete.")
