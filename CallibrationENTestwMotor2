#version 1.2 - Hitec HS-311 FIXED
import RPi.GPIO as GPIO
import time
import serial
import threading

# =========================
# Pin definitions (BCM)
# =========================
SWITCH_PIN = 27
BUTTON_PIN = 22
BUZZER_PIN = 26
SERVO_PIN  = 18

# =========================
# Global state
# =========================
Calibration_Flag = False
running = True

# =========================
# Setup GPIO
# =========================
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()

# HS-311 Servo PWM
servo = GPIO.PWM(SERVO_PIN, 50)
servo.start(0)

# =========================
# HS-311 STARTUP TEST
# =========================
print("🧪 Testing Hitec HS-311 range...")
for angle in [0, 45, 90, 135, 180, 90, 0]:
    print(f"  → {angle}°")
    servo_set_angle(angle)  # Uses new function below
    time.sleep(1)
print("HS-311 test complete!")

ser = serial.Serial('/dev/ttyAMA0', 115200)

# =========================
# Buzzer / melody (unchanged)
# =========================
NOTE_E5=659;NOTE_D5=587;NOTE_FS4=370;NOTE_GS4=415
NOTE_CS5=554;NOTE_B4=494;NOTE_D4=294;NOTE_E4=330
NOTE_A4=440;NOTE_CS4=277

melody = [NOTE_E5,NOTE_D5,NOTE_FS4,NOTE_GS4,NOTE_CS5,NOTE_B4,NOTE_D4,NOTE_E4,NOTE_B4,NOTE_A4,NOTE_CS4,NOTE_E4,NOTE_A4]
durations = [8,8,4,4,8,8,4,4,8,8,4,4,2]

def play_note(freq, duration_s):
    if freq <= 0: 
        buzzer.stop()
        time.sleep(duration_s)
        return
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration_s * 0.9)
    buzzer.stop()
    time.sleep(duration_s * 0.1)

def play_melody():
    for i in range(len(durations)):
        play_note(melody[i], 1000/durations[i]/1000)

def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

# =========================
# HS-311 SPECIFIC PWM (575-2460μs)
# =========================
def angle_to_duty(angle):
    """Hitec HS-311: 575μs(2.88%) → 2460μs(12.3%)"""
    angle = max(0, min(180, angle))
    pulse_us = 575 + (2460-575) * (angle / 180)
    duty = (pulse_us / 20000) * 100  # 50Hz = 20ms period
    return round(duty, 2)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# Threads
# =========================
def uart_reader():
    global running
    while running:
        try:
            line = ser.readline().decode().strip()
            if line: print("EMG:", line)
        except: pass

def servo_oscillator():
    global running
    direction = 1
    angle = 30  # START at 30° (avoid dead zone)
    step = 12
    delay = 0.04

    while running:
        if GPIO.input(SWITCH_PIN):
            servo_set_angle(angle)
            angle += direction * step
            if angle >= 180:
                angle = 180; direction = -1
            elif angle <= 0:
                angle = 0; direction = 1
            time.sleep(delay)
        else:
            servo_set_angle(0)
            time.sleep(0.1)

# =========================
# Main
# =========================
try:
    print("HS-311 v1.2: Switch=SWEEP | Button=CALIB | EMG live")

    threading.Thread(target=uart_reader, daemon=True).start()
    threading.Thread(target=servo_oscillator, daemon=True).start()

    last_button = GPIO.input(BUTTON_PIN)

    while True:
        switch_on = GPIO.input(SWITCH_PIN)
        button_pressed = GPIO.input(BUTTON_PIN) == 0

        if last_button == 1 and GPIO.input(BUTTON_PIN) == 0:
            Calibration_Flag = True
            print(f"\n🎵 CALIB Flag={Calibration_Flag}")
            short_beep(0.1, 2500)
            play_melody()

        last_button = GPIO.input(BUTTON_PIN)

        print(f"S:{'🟢ON' if switch_on else '🔴'} B:{'P' if button_pressed else '-'} F:{Calibration_Flag}", end='\r')
        time.sleep(0.02)

except KeyboardInterrupt: pass
finally:
    running = False
    servo.ChangeDutyCycle(0)
    time.sleep(0.5)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\nDone!")
