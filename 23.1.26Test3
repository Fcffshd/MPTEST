# EMG Threshold Servo v2.3 - DS5180 0-120° LIMIT + BASELINE CALIBRATION + EMA+DEADBAND

import RPi.GPIO as GPIO
import time
import serial
import threading
import numpy as np

# =========================
# Pins (BCM)
# =========================
SWITCH_PIN = 27  # MOTOR ON
BUTTON_PIN = 22  # Calibrate
BUZZER_PIN = 26  # Buzzer
SERVO_PIN = 18   # Hardware PWM0 (GPIO18)

# =========================
# Globals
# =========================
running = True
calibrating = False
calibration_start_time = 0
emg_data = []
calib_complete = False
no_flex_start = 0
smoothed_emg = 1.5
current_phase = "RELAX"
smoothed_angle = 0

# Dynamic thresholds
thresholds = {}

# EMA + STABILIZER PARAMETERS
EMA_ALPHA = 0.15      # EMA smoothing (lower = smoother)
ANGLE_DEADBAND = 2.0  # ignore <2° changes
ANGLE_MAX_STEP = 8.0  # max degrees per update (reduced for 120° range) [file:1]
last_angle = None

# =========================
# GPIO + PWM Setup
# =========================
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

buzzer_pwm = GPIO.PWM(BUZZER_PIN, 440)
servo_pwm = GPIO.PWM(SERVO_PIN, 50)
buzzer_pwm.stop()
servo_pwm.start(0)

ser = serial.Serial('/dev/ttyAMA0', 115200, timeout=0.05)

# =========================
# DS5180 SERVO FUNCTIONS (0-120° HARD LIMIT)
# =========================
def angle_to_duty(angle):
    angle = max(0, min(120, angle))  # Hard limit 0-120°
    pulse_us = 900 + (870 * angle / 120)  # 0°=900µs, 120°=1770µs [web:4]
    return round((pulse_us / 20000) * 100, 2)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo_pwm.ChangeDutyCycle(duty)

# =========================
# 1.5V-2.8V LINEAR + THRESHOLD MODES (CAPPED AT 120°)
# =========================
def emg_to_angle(voltage):
    global current_phase
    
    if not calib_complete:
        # LINEAR FALLBACK: 1.5V=0° → 2.8V=120° max
        if voltage <= 1.5: return 0
        elif voltage >= 2.8: return 120
        else: return min(120, int((voltage - 1.5) / 1.3 * 120))
    else:
        # BASELINE THRESHOLD MODE (adjusted for 120°)
        baseline = thresholds.get('BASELINE', 1.8)
        medium_threshold = thresholds.get('MEDIUM_THRESHOLD', 2.15)
        
        if voltage < baseline:
            current_phase = "RELAX"
            return 0
        elif voltage < medium_threshold:
            current_phase = "MEDIUM"
            return 60  # Scaled from 90°
        else:
            current_phase = "FULL"
            return 120

# =========================
# EMA + ANGLE STABILIZER
# =========================
def ema_filter(raw_v):
    global smoothed_emg
    smoothed_emg = EMA_ALPHA * raw_v + (1 - EMA_ALPHA) * smoothed_emg
    return smoothed_emg

def stable_angle(target_angle):
    global last_angle, smoothed_angle
    
    target_angle = max(0, min(120, target_angle))  # Enforce limit here too
    
    if last_angle is None:
        last_angle = target_angle
        smoothed_angle = target_angle
        return target_angle
    
    # deadband
    if abs(target_angle - last_angle) < ANGLE_DEADBAND:
        return last_angle
    
    # rate limiting
    if target_angle > last_angle + ANGLE_MAX_STEP:
        last_angle += ANGLE_MAX_STEP
    elif target_angle < last_angle - ANGLE_MAX_STEP:
        last_angle -= ANGLE_MAX_STEP
    else:
        last_angle = target_angle
    
    # smooth the final output
    smoothed_angle = 0.4 * last_angle + 0.6 * smoothed_angle
    return max(0, min(120, smoothed_angle))  # Final clamp

# =========================
# EMG CONTROL PIPELINE
# =========================
def emg_control(raw_emg):
    global current_phase
    
    v_ema = ema_filter(raw_emg)
    target_angle = emg_to_angle(v_ema)
    stable_ang = stable_angle(target_angle)
    servo_set_angle(stable_ang)
    
    return v_ema, stable_ang, current_phase

# =========================
# NEW BASELINE CALIBRATION (0-10s = BASELINE)
# =========================
def process_calibration():
    global thresholds, calib_complete
    
    # 0-10s: BASELINE (relax + early medium = true minimum)
    baseline_data = np.array([v for ts, v in emg_data if no_flex_start <= ts < no_flex_start + 10])
    
    # 10-20s: MEDIUM + FULL (strong effort)
    effort_data = np.array([v for ts, v in emg_data if no_flex_start + 10 <= ts < no_flex_start + 20])
    
    if len(baseline_data) > 10:
        thresholds['BASELINE'] = np.percentile(baseline_data, 25)
        thresholds['BASELINE_MEAN'] = np.mean(baseline_data)
    
    if len(effort_data) > 15:
        thresholds['MEDIUM_THRESHOLD'] = np.percentile(effort_data, 40)
        thresholds['MEDIUM_MEAN'] = np.mean(effort_data[:len(effort_data)//2])
        thresholds['FULL_MEAN'] = np.mean(effort_data[len(effort_data)//2:])
    
    print("\n" + "="*80)
    print("✅ BASELINE THRESHOLDS READY - FLIP SWITCH 27 ON!")
    print("="*80)
    print(f"BASELINE: {thresholds.get('BASELINE_MEAN',0):6.3f}V (25th={thresholds.get('BASELINE',0):6.3f}V) → 0°")
    print(f"MEDIUM: MEAN={thresholds.get('MEDIUM_MEAN',0):6.3f}V (th={thresholds.get('MEDIUM_THRESHOLD',0):6.3f}V) → 60°")
    print(f"FULL: MEAN={thresholds.get('FULL_MEAN',0):6.3f}V → 120°")
    print("="*80)
    
    calib_complete = True

# =========================
# Buzzer + Melody
# =========================
def short_beep(duration=0.1, freq=2000):
    buzzer_pwm.ChangeFrequency(freq)
    buzzer_pwm.start(50)
    time.sleep(duration)
    buzzer_pwm.stop()

def play_calib_sequence():
    for _ in range(3): short_beep(0.1, 1500); time.sleep(0.1)
    short_beep(0.5, 1000)

NOTE_E5=659; NOTE_D5=587; NOTE_FS4=370; NOTE_GS4=415
NOTE_CS5=554; NOTE_B4=494; NOTE_D4=294; NOTE_E4=330
NOTE_A4=440; NOTE_CS4=277
melody = [NOTE_E5,NOTE_D5,NOTE_FS4,NOTE_GS4,NOTE_CS5,NOTE_B4,NOTE_D4,NOTE_E4,NOTE_B4,NOTE_A4,NOTE_CS4,NOTE_E4,NOTE_A4]
durations = [8,8,4,4,8,8,4,4,8,8,4,4,2]

def play_melody():
    for i,d in enumerate(durations):
        short_beep(1000/d/1000, melody[i])

# =========================
# EMG Reader Thread
# =========================
def uart_reader():
    while running:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith("EMG:"):
                    voltage = float(line.split(":")[1].split("V")[0])
                    if calibrating:
                        emg_data.append((time.time(), voltage))
        except:
            pass
        time.sleep(0.01)

# =========================
# MAIN LOOP - NEW 20s PROTOCOL
# =========================
print("🧪 DS5180 Startup Test (1.5-2.8V EMA, 0-120° max)...")
test_volts = [1.5, 1.8, 2.15, 2.4, 2.8, 2.15, 1.5]
for v in test_volts:
    ang = emg_to_angle(v)
    print(f" {v}V → {ang}°")
    servo_set_angle(ang)
    time.sleep(0.5)

threading.Thread(target=uart_reader, daemon=True).start()

try:
    print("\n🎯 EMG BASELINE Calibration | Button=Start | Switch=Motor")
    print("📊 0–10s: RELAX/NORMAL | 10–20s: MEDIUM+FULL → Creates LOW BASELINE")
    
    button_last_state = GPIO.input(BUTTON_PIN)
    while True:
        button_state = GPIO.input(BUTTON_PIN)
        
        if button_last_state == 1 and button_state == 0:
            if not calibrating and not calib_complete:
                calibrating = True
                calib_complete = False
                calibration_start_time = time.time()
                emg_data.clear()
                no_flex_start = calibration_start_time
                play_calib_sequence()
                print("\n🚀 *** 20s BASELINE CALIBRATION ***")
                print(" ➤ 0–10s: RELAX (find your TRUE minimum)")
                print(" ➤ 10–20s: MEDIUM → FULL (strong effort)")
            elif calib_complete:
                print("\n🔄 Baseline set. Button for melody.")
                play_melody()
        
        button_last_state = button_state
        
        if calibrating:
            elapsed = time.time() - calibration_start_time
            if elapsed < 10:
                phase_msg = "RELAX (BASELINE)"
                color = "🟢"
            else:
                phase_msg = "MEDIUM+FULL"
                color = "🔴"
            print(f"\r⏱ {elapsed:4.1f}s | {color} {phase_msg:<15}", end="")
            
            if elapsed >= 20.0:
                calibrating = False
                play_calib_sequence()
                print("\n✅ Creating baseline thresholds...")
                process_calibration()
        
        elif calib_complete and GPIO.input(SWITCH_PIN):
            try:
                if ser.in_waiting > 0:
                    line = ser.readline().decode('utf-8', errors='ignore').strip()
                    if line.startswith("EMG:"):
                        raw_emg = float(line.split(":")[1].split("V")[0])
                        smooth_emg, angle, phase = emg_control(raw_emg)
                        print(f"\rEMG:{raw_emg:.3f}V EMA:{smooth_emg:.3f}V [{phase}] {angle:3.0f}°", end="")
            except:
                pass
        else:
            servo_set_angle(0)
        
        switch_state = GPIO.input(SWITCH_PIN)
        status = f"Mode:{'CALIB' if calibrating else 'BASELINE'} | Motor:{'ON' if switch_state and calib_complete else 'OFF'}"
        print(f"\r{status:<65}", end="")
        
        time.sleep(0.02)

except KeyboardInterrupt:
    print("\nShutting down...")
finally:
    running = False
    servo_pwm.stop()
    buzzer_pwm.stop()
    GPIO.cleanup()
    ser.close()
    print("✅ v2.3 DS5180 0-120° LIMIT - Done!") [file:1]
