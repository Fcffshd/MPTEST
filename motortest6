import RPi.GPIO as GPIO
import time

SERVO_PIN = 18
MAX_ANGLE = 270  # use 180 if you set the servo to 180° mode

GPIO.setmode(GPIO.BCM)
GPIO.setup(SERVO_PIN, GPIO.OUT)
servo = GPIO.PWM(SERVO_PIN, 50)  # 50Hz
servo.start(0)
time.sleep(1)

def angle_to_duty(angle):
    angle = max(0, min(MAX_ANGLE, angle))
    pulse_min = 500.0   # us
    pulse_max = 2500.0  # us
    pulse = pulse_min + (pulse_max - pulse_min) * (angle / MAX_ANGLE)
    duty = (pulse / 20000.0) * 100.0  # 20ms frame
    return duty

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)
    time.sleep(0.03)

try:
    print(f"Sweeping 0° → {MAX_ANGLE}° slowly...")
    while True:
        for a in range(0, MAX_ANGLE + 1, 3):
            print(f"\rAngle: {a}°", end="")
            servo_set_angle(a)
        for a in range(MAX_ANGLE, -1, -3):
            print(f"\rAngle: {a}°", end="")
            servo_set_angle(a)
except KeyboardInterrupt:
    pass
finally:
    servo.ChangeDutyCycle(0)
    time.sleep(0.5)
    servo.stop()
    GPIO.cleanup()
    print("\nDone")
