import RPi.GPIO as GPIO
import time

# Pin definitions (BCM)
SWITCH_PIN = 27   # 3‑prong switch COM
BUTTON_PIN = 22   # push button
BUZZER_PIN = 26   # passive buzzer +

GPIO.setmode(GPIO.BCM)

GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)  # Switch
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)    # Button
GPIO.setup(BUZZER_PIN, GPIO.OUT)                             # Buzzer

buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()

# Frequencies for notes (Hz)
NOTE_E5  = 659
NOTE_D5  = 587
NOTE_FS4 = 370
NOTE_GS4 = 415
NOTE_CS5 = 554
NOTE_B4  = 494
NOTE_D4  = 294
NOTE_E4  = 330
NOTE_A4  = 440
NOTE_CS4 = 277

melody = [
    NOTE_E5, NOTE_D5, NOTE_FS4, NOTE_GS4,
    NOTE_CS5, NOTE_B4, NOTE_D4, NOTE_E4,
    NOTE_B4, NOTE_A4, NOTE_CS4, NOTE_E4,
    NOTE_A4
]

durations = [
    8, 8, 4, 4,
    8, 8, 4, 4,
    8, 8, 4, 4,
    2
]

def play_note(freq, duration_s):
    if freq <= 0:
        buzzer.stop()
        time.sleep(duration_s)
        return
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration_s * 0.9)
    buzzer.stop()
    time.sleep(duration_s * 0.1)

def play_melody():
    size = len(durations)
    for i in range(size):
        duration_ms = 1000.0 / durations[i]   # like Arduino code
        duration_s = duration_ms / 1000.0
        play_note(melody[i], duration_s)

def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

try:
    print("Switch/Button/Buzzer test with melody. Ctrl+C to exit.")
    while True:
        switch_on = GPIO.input(SWITCH_PIN)           # 1 when switch ON
        button_pressed = not GPIO.input(BUTTON_PIN)  # 0 when pressed

        print(
            f"Switch: {'ON' if switch_on else 'OFF'}, "
            f"Button: {'PRESSED' if button_pressed else 'RELEASED'}",
            end="\r"
        )

        if switch_on and button_pressed:
            short_beep(0.1, 2500)
            play_melody()
            time.sleep(0.3)

        time.sleep(0.02)

except KeyboardInterrupt:
    pass
finally:
    buzzer.stop()
    GPIO.cleanup()
