# EMG PID Servo Control v1.6 - 20s Calibration w/ MEAN/MEDIAN Thresholds
import RPi.GPIO as GPIO
import time
import serial
import threading
import numpy as np

# =========================
# Pin definitions (BCM)
# =========================
SWITCH_PIN = 27   # PID enable switch
BUTTON_PIN = 22   # Calibration trigger
BUZZER_PIN = 26   # Buzzer
SERVO_PIN  = 18   # Servo PWM

# =========================
# Globals
# =========================
running = True
pid_enabled = False
calibrating = False
calibration_start_time = 0
emg_data = []  # (timestamp, voltage)
calib_complete = False
no_flex_start = 0
smoothed_emg = 0.8

# Dynamic thresholds (set by calibration)
thresholds = {
    'PID_KP': 0.20, 'PID_KI': 0.05, 'PID_KD': 0.05
}

# =========================
# GPIO + PWM Setup
# =========================
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()
servo = GPIO.PWM(SERVO_PIN, 50)  # 50Hz servo
servo.start(0)

ser = serial.Serial('/dev/ttyAMA0', 115200, timeout=0.05)

# =========================
# PID Controller
# =========================
class PID:
    def __init__(self, kp, ki, kd, min_out, max_out):
        self.kp, self.ki, self.kd = kp, ki, kd
        self.min_out, self.max_out = min_out, max_out
        self.reset()

    def reset(self):
        self.prev_error = 0
        self.integral = 0
        self.last_time = time.time()

    def update(self, setpoint, measurement):
        current_time = time.time()
        dt = current_time - self.last_time
        if dt <= 0: return 0
        
        error = setpoint - measurement
        self.integral += error * dt
        self.integral = max(-10, min(10, self.integral))  # Anti-windup
        
        P = self.kp * error
        I = self.ki * self.integral
        D = self.kd * (error - self.prev_error) / dt
        
        output = P + I + D
        output = max(self.min_out, min(self.max_out, output))
        
        self.prev_error = error
        self.last_time = current_time
        return output

# =========================
# Servo Functions (0-180°)
# =========================
def angle_to_duty(angle):
    angle = max(0, min(180, angle))
    return 2.5 + (10.0 - 2.5) * (angle / 180.0)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# 20s Calibration w/ MEAN/MEDIAN
# =========================
def process_calibration():
    """Calculate MEAN/MEDIAN thresholds for each phase"""
    global thresholds, calib_complete
    
    # Extract 3 phases (5s + 10s + 5s = 20s)
    no_flex_data = np.array([v for ts, v in emg_data if no_flex_start <= ts < no_flex_start + 5])
    medium_data = np.array([v for ts, v in emg_data if no_flex_start + 5 <= ts < no_flex_start + 15])
    full_data = np.array([v for ts, v in emg_data if no_flex_start + 15 <= ts < no_flex_start + 20])
    
    # MEAN and MEDIAN thresholds
    if len(no_flex_data) > 5:  # Min samples
        thresholds['RELAX_MEAN'] = np.mean(no_flex_data)
        thresholds['RELAX_MEDIAN'] = np.median(no_flex_data)
        thresholds['RELAX_THRESHOLD'] = thresholds['RELAX_MEDIAN']
        
    if len(medium_data) > 10:
        thresholds['MEDIUM_MEAN'] = np.mean(medium_data)
        thresholds['MEDIUM_MEDIAN'] = np.median(medium_data)
        thresholds['MEDIUM_THRESHOLD'] = thresholds['MEDIUM_MEDIAN']
        
    if len(full_data) > 5:
        thresholds['FULL_MEAN'] = np.mean(full_data)
        thresholds['FULL_MEDIAN'] = np.median(full_data)
        thresholds['FULL_THRESHOLD'] = thresholds['FULL_MEDIAN']
    
    # PID uses calibrated range
    thresholds['PID_MIN'] = thresholds.get('RELAX_THRESHOLD', 0.5)
    thresholds['PID_MAX'] = thresholds.get('FULL_THRESHOLD', 2.5)
    
    print("\n" + "="*80)
    print("✅ 20s CALIBRATION COMPLETE - MEAN/MEDIAN THRESHOLDS")
    print("="*80)
    print(f"RELAX:  MEAN={thresholds['RELAX_MEAN']:6.3f}V | MEDIAN(THRESHOLD)={thresholds['RELAX_THRESHOLD']:6.3f}V")
    print(f"MEDIUM: MEAN={thresholds['MEDIUM_MEAN']:6.3f}V | MEDIAN(THRESHOLD)={thresholds['MEDIUM_THRESHOLD']:6.3f}V")
    print(f"FULL:   MEAN={thresholds['FULL_MEAN']:6.3f}V | MEDIAN(THRESHOLD)={thresholds['FULL_THRESHOLD']:6.3f}V")
    print(f"PID Range: {thresholds['PID_MIN']:5.3f}V → {thresholds['PID_MAX']:5.3f}V")
    print("="*80)
    
    # Test classification
    phase = classify_emg(smoothed_emg)
    print(f"Current EMG {smoothed_emg:.2f}V → {phase}")
    
    calib_complete = True

def classify_emg(emg_value):
    """Classify based on median thresholds"""
    if emg_value < thresholds.get('MEDIUM_THRESHOLD', 1.0):
        return "RELAX"
    elif emg_value < thresholds.get('FULL_THRESHOLD', 2.0):
        return "MEDIUM"
    else:
        return "FULL"

# =========================
# Buzzer Functions
# =========================
def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

def play_calib_sequence():
    for _ in range(3):
        short_beep(0.1, 1500)
        time.sleep(0.1)
    time.sleep(0.5)
    short_beep(0.5, 1000)

# =========================
# EMG UART Reader Thread
# =========================
def uart_reader():
    global emg_data, calibrating, smoothed_emg
    while running:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith("EMG:"):
                    voltage = float(line.split(":")[1].split("V")[0])
                    
                    # Global smoothing
                    alpha = 0.1
                    smoothed_emg = alpha * voltage + (1 - alpha) * smoothed_emg
                    
                    if calibrating:
                        emg_data.append((time.time(), voltage))
                    
                    print(f"EMG:{voltage:.2f}V S:{smoothed_emg:.2f}V", end='\r')
        except:
            pass
        time.sleep(0.01)

# =========================
# EMG PID Control Thread
# =========================
def emg_pid_thread():
    global pid_enabled
    
    while running:
        switch_state = GPIO.input(SWITCH_PIN)
        pid_enabled = switch_state
        
        if pid_enabled and calib_complete:
            # Create PID with calibrated range
            pid_controller = PID(thresholds['PID_KP'], thresholds['PID_KI'], thresholds['PID_KD'],
                                thresholds['PID_MIN'], thresholds['PID_MAX'])
            
            try:
                # PID: Track FULL_THRESHOLD for max clench = max servo
                adjustment = pid_controller.update(thresholds['FULL_THRESHOLD'], smoothed_emg)
                target_emg = smoothed_emg + adjustment
                target_emg = max(thresholds['PID_MIN'], min(thresholds['PID_MAX'], target_emg))
                
                # Map to servo angle (0-180°)
                angle = int((target_emg - thresholds['PID_MIN']) / 
                           (thresholds['PID_MAX'] - thresholds['PID_MIN']) * 180)
                servo_set_angle(angle)
                
                phase = classify_emg(smoothed_emg)
                print(f"EMG:{smoothed_emg:.2f} PID:{adjustment:.2f} {angle}° [{phase}]", end='\r')
                
            except:
                pass
        else:
            servo_set_angle(0)
        
        time.sleep(0.02)

# =========================
# MAIN LOOP
# =========================
try:
    print("EMG PID Servo v1.6 | Button=20s Calib | Switch=PID ON")
    print("📊 0-5s RELAX → 5-15s MEDIUM → 15-20s FULL_FLEX")
    
    # Start threads
    threading.Thread(target=uart_reader, daemon=True).start()
    threading.Thread(target=emg_pid_thread, daemon=True).start()
    
    last_button = 1
    while True:
        button = GPIO.input(BUTTON_PIN)
        
        # Button: Start calibration
        if last_button == 1 and button == 0:
            if not calibrating and not calib_complete:
                calibrating = True
                calib_complete = False
                calibration_start_time = time.time()
                emg_data.clear()
                no_flex_start = calibration_start_time
                play_calib_sequence()
                print("\n🚀 *** 20s CALIBRATION STARTED ***")
                print("   0-5s: RELAX  | 5-15s: MEDIUM  | 15-20s: FULL FLEX!")
            elif calib_complete:
                print("\n🔄 Press to recalibrate")
        
        # Calibration progress
        if calibrating:
            elapsed = time.time() - calibration_start_time
            if elapsed >= 20.0:
                calibrating = False
                process_calibration()
            else:
                phase = "RELAX" if elapsed < 5 else "MEDIUM" if elapsed < 15 else "FULL"
                print(f"Calib: {elapsed:5.1f}s [{phase:6}]", end='\r')
        
        last_button = button
        time.sleep(0.05)

except KeyboardInterrupt:
    print("\nShutting down...")
finally:
    running = False
    time.sleep(0.5)
    servo.ChangeDutyCycle(0)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("✅ EMG PID Servo v1.6 shutdown complete")

