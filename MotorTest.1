import RPi.GPIO as GPIO
import time

AIN1 = 17   # BCM numbering
AIN2 = 27

GPIO.setmode(GPIO.BCM)
GPIO.setup(AIN1, GPIO.OUT)
GPIO.setup(AIN2, GPIO.OUT)

# Optional: PWM for speed control
pwm1 = GPIO.PWM(AIN1, 1000)  # 1 kHz
pwm2 = GPIO.PWM(AIN2, 1000)
pwm1.start(0)
pwm2.start(0)

def forward(speed=100):
    pwm1.ChangeDutyCycle(speed)  # AIN1 = PWM
    pwm2.ChangeDutyCycle(0)      # AIN2 = 0

def reverse(speed=100):
    pwm1.ChangeDutyCycle(0)
    pwm2.ChangeDutyCycle(speed)

def brake():
    pwm1.ChangeDutyCycle(100)
    pwm2.ChangeDutyCycle(100)

def coast():
    pwm1.ChangeDutyCycle(0)
    pwm2.ChangeDutyCycle(0)

try:
    forward(60)
    time.sleep(2)
    reverse(60)
    time.sleep(2)
    brake()
finally:
    pwm1.stop()
    pwm2.stop()
    GPIO.cleanup()
