import RPi.GPIO as GPIO
import time
import serial
import threading

# =========================
# CONFIGURATION & TUNING
# =========================
# Change these values to adjust sensitivity
MIN_EMG_V = 0.8    # Voltage for 0 degrees
MAX_EMG_V = 1.8    # Voltage for 180 degrees

# PID TUNING: Adjust these to change how the arm feels
# Kp (Proportional): Higher = Faster reaction, more jitter
# Ki (Integral):     Higher = Pushes harder to reach exact target (can cause overshoot)
# Kd (Derivative):   Higher = Resists sudden changes (dampens the "fuzziness")
PID_KP = 0.20      
PID_KI = 0.05
PID_KD = 0.05

# Pins
SWITCH_PIN = 27
BUTTON_PIN = 22
BUZZER_PIN = 26
SERVO_PIN  = 18

Calibration_Flag = False
running = True

# GPIO setup
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()

servo = GPIO.PWM(SERVO_PIN, 50)
servo.start(0)

ser = serial.Serial('/dev/ttyAMA0', 115200)

# =========================
# PID CLASS (The Smoothing Engine)
# =========================
class PID:
    def __init__(self, kp, ki, kd, min_out, max_out):
        self.kp = kp
        self.ki = ki
        self.kd = kd
        self.min_out = min_out
        self.max_out = max_out
        self.prev_error = 0
        self.integral = 0
        self.last_time = time.time()

    def update(self, setpoint, measurement):
        """
        Calculates how much to move the servo based on the target (EMG)
        and where we think the servo is (measurement).
        """
        current_time = time.time()
        dt = current_time - self.last_time
        if dt <= 0: return 0
        
        error = setpoint - measurement
        
        # Proportional
        P = self.kp * error
        
        # Integral
        self.integral += error * dt
        I = self.ki * self.integral
        
        # Derivative (Dampening)
        D = self.kd * (error - self.prev_error) / dt
        
        output = P + I + D
        
        self.prev_error = error
        self.last_time = current_time
        
        return output

# Initialize PID
pid_controller = PID(PID_KP, PID_KI, PID_KD, MIN_EMG_V, MAX_EMG_V)

# =========================
# HS-311 SERVO FUNCTIONS
# =========================
def angle_to_duty(angle):
    """Hitec HS-311: safer 900–2100μs range"""
    angle = max(0, min(180, angle))
    pulse_us = 900 + (2100-900) * (angle / 180)
    return round((pulse_us / 20000) * 100, 2)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# NEW DYNAMIC MAPPING
# =========================
def voltage_to_angle(voltage):
    """Dynamic mapping using MIN_EMG_V and MAX_EMG_V"""
    if voltage <= MIN_EMG_V:
        return 0
    elif voltage >= MAX_EMG_V:
        return 180
    else:
        # Linear interpolation
        return int((voltage - MIN_EMG_V) / (MAX_EMG_V - MIN_EMG_V) * 180)

# =========================
# BUZZER FUNCTIONS
# =========================
def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

# =========================
# EMG THREAD WITH PID
# =========================
def uart_reader():
    global running
    
    # We track the "current" smoothed voltage internally
    current_smoothed_voltage = MIN_EMG_V 
    
    while running:
        try:
            # Check if serial has data waiting (prevents blocking loop excessively)
            if ser.in_waiting > 0:
                line = ser.readline().decode().strip()
                if line.startswith("EMG:"):
                    try:
                        # 1. READ RAW TARGET (Your noisy muscle signal)
                        emg_str = line.split(":")[1].strip().split()[0]
                        target_voltage = float(emg_str)
                        
                        # 2. RUN PID
                        # We ask PID: "Here is where I want to be (target_voltage),
                        # and here is where I am (current_smoothed_voltage). How much should I move?"
                        adjustment = pid_controller.update(target_voltage, current_smoothed_voltage)
                        
                        # 3. APPLY ADJUSTMENT
                        current_smoothed_voltage += adjustment
                        
                        # 4. CLAMP LIMITS (Safety)
                        # Even if PID overshoots, we lock it to your request limits
                        if current_smoothed_voltage > MAX_EMG_V: current_smoothed_voltage = MAX_EMG_V
                        if current_smoothed_voltage < MIN_EMG_V: current_smoothed_voltage = MIN_EMG_V

                        # 5. MOVE SERVO
                        final_angle = voltage_to_angle(current_smoothed_voltage)
                        servo_set_angle(final_angle)
                        
                        # Debug: Show Target vs Smoothed Result
                        # print(f"Tgt:{target_voltage:.2f}V | Smth:{current_smoothed_voltage:.2f}V | Ang:{final_angle}")

                    except (ValueError, IndexError):
                        pass
            else:
                # Small sleep to prevent CPU hogging if no data
                time.sleep(0.001)
                
        except Exception as e:
            print(f"Error: {e}")
            time.sleep(0.01)

# =========================
# MAIN
# =========================
try:
    print(f"EMG Servo PID Ready.")
    print(f"Range: {MIN_EMG_V}V (0deg) -> {MAX_EMG_V}V (180deg)")
    
    # Update PID limit variables just in case
    pid_controller.min_out = MIN_EMG_V
    pid_controller.max_out = MAX_EMG_V

    threading.Thread(target=uart_reader, daemon=True).start()

    last_button = GPIO.input(BUTTON_PIN)
    
    while True:
        # Button Logic
        if last_button == 1 and GPIO.input(BUTTON_PIN) == 0:
            Calibration_Flag = True
            print(f"\n🎵 Calibration Triggered")
            short_beep(0.1, 2500)
            
            # Example: Dynamic limit change via button (Optional)
            # You could toggle between "Sensitive" and "Strong" modes here
            # MIN_EMG_V = 0.5 
            # MAX_EMG_V = 2.5
            
        last_button = GPIO.input(BUTTON_PIN)
        time.sleep(0.02)

except KeyboardInterrupt: 
    pass
finally:
    running = False
    servo.ChangeDutyCycle(0)
    time.sleep(0.5)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\nDone!")
