#version 1.2
import RPi.GPIO as GPIO
import time
import serial
import threading

# =========================
# Pin definitions (BCM)
# =========================
SWITCH_PIN = 27   # 3‑prong switch COM
BUTTON_PIN = 22   # push button
BUZZER_PIN = 26   # passive buzzer +
SERVO_PIN  = 18   # PWM0 output for servo (GPIO18)

# =========================
# Global state
# =========================
Calibration_Flag = False
running = True

# =========================
# Setup GPIO
# =========================
GPIO.setmode(GPIO.BCM)

GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)  # Switch
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)    # Button (active low)
GPIO.setup(BUZZER_PIN, GPIO.OUT)                             # Buzzer
GPIO.setup(SERVO_PIN, GPIO.OUT)                              # Servo PWM

# Buzzer PWM
buzzer = GPIO.PWM(BUZZER_PIN, 440)  # default freq
buzzer.stop()

# Servo PWM (typical 50 Hz for hobby servos)
servo = GPIO.PWM(SERVO_PIN, 50)     # 50 Hz
servo.start(0)  # start with 0% duty (no pulse)

# =========================
# EMG UART setup
# =========================
ser = serial.Serial('/dev/ttyAMA0', 115200)

# =========================
# Buzzer / melody definitions
# =========================
NOTE_E5  = 659
NOTE_D5  = 587
NOTE_FS4 = 370
NOTE_GS4 = 415
NOTE_CS5 = 554
NOTE_B4  = 494
NOTE_D4  = 294
NOTE_E4  = 330
NOTE_A4  = 440
NOTE_CS4 = 277

melody = [
    NOTE_E5, NOTE_D5, NOTE_FS4, NOTE_GS4,
    NOTE_CS5, NOTE_B4, NOTE_D4, NOTE_E4,
    NOTE_B4, NOTE_A4, NOTE_CS4, NOTE_E4,
    NOTE_A4
]

durations = [
    8, 8, 4, 4,
    8, 8, 4, 4,
    8, 8, 4, 4,
    2
]

def play_note(freq, duration_s):
    if freq <= 0:
        buzzer.stop()
        time.sleep(duration_s)
        return
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration_s * 0.9)
    buzzer.stop()
    time.sleep(duration_s * 0.1)

def play_melody():
    size = len(durations)
    for i in range(size):
        duration_ms = 1000.0 / durations[i]   # like Arduino code
        duration_s = duration_ms / 1000.0
        play_note(melody[i], duration_s)

def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

# =========================
# Servo helper - CHANGED TO 180°
# =========================
def angle_to_duty(angle):
    """
    Map angle (0–180 deg) to duty cycle for 50 Hz PWM.
    Standard servo timing: 2.5% duty (0°) to 10% duty (180°).
    """
    min_duty = 2.5   # 0.5ms pulse / 20ms period = 2.5%
    max_duty = 10.0  # 2.0ms pulse / 20ms period = 10%
    angle = max(0, min(180, angle))
    duty = min_duty + (max_duty - min_duty) * (angle / 180.0)
    return duty

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# Thread: Read EMG over UART
# =========================
def uart_reader():
    global running
    while running:
        try:
            line = ser.readline().decode().strip()
            if line:
                print("Received EMG:", line)
        except Exception:
            pass

# =========================
# Thread: Servo oscillation - CHANGED TO 180°
# =========================
def servo_oscillator():
    """
    Oscillate servo between 0° and 180° while switch is ON.
    """
    global running
    direction = 1
    angle = 0
    step = 10
    delay = 0.05

    while running:
        switch_on = GPIO.input(SWITCH_PIN)

        if switch_on:
            servo_set_angle(angle)
            time.sleep(delay)

            angle += direction * step

            if angle >= 180:  # CHANGED: 180° limit
                angle = 180
                direction = -1
            elif angle <= 0:
                angle = 0
                direction = 1
        else:
            servo_set_angle(0)
            time.sleep(0.1)

# =========================
# Main
# =========================
try:
    print("System start: Switch/Button/Buzzer/Servo(0-180°)/EMG. Ctrl+C to exit.")

    uart_thread = threading.Thread(target=uart_reader, daemon=True)
    servo_thread = threading.Thread(target=servo_oscillator, daemon=True)
    uart_thread.start()
    servo_thread.start()

    last_button_state = GPIO.input(BUTTON_PIN)

    while True:
        switch_on = GPIO.input(SWITCH_PIN)
        button_state = GPIO.input(BUTTON_PIN)
        button_pressed = (button_state == 0)

        if last_button_state == 1 and button_state == 0:
            Calibration_Flag = True
            print("\nCalibration button pressed -> Calibration_Flag = True")
            short_beep(0.1, 2500)
            play_melody()

        last_button_state = button_state

        print(
            f"Switch: {'ON' if switch_on else 'OFF'}, "
            f"Button: {'PRESSED' if button_pressed else 'RELEASED'}, "
            f"Calibration_Flag: {Calibration_Flag}",
            end="\r"
        )

        time.sleep(0.02)

except KeyboardInterrupt:
    pass
finally:
    running = False
    servo.ChangeDutyCycle(0)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\nClean exit.")
