# EMG PID Servo Control v1.5 - 20s Calibration + PID
import RPi.GPIO as GPIO
import time
import serial
import threading
import numpy as np

# =========================
# Pin definitions (BCM)
# =========================
SWITCH_PIN = 27   # PID enable switch
BUTTON_PIN = 22   # Calibration trigger
BUZZER_PIN = 26   # Buzzer
SERVO_PIN  = 18   # Servo PWM

# =========================
# Globals
# =========================
running = True
pid_enabled = False
calibrating = False
calibration_start_time = 0
emg_data = []  # (timestamp, voltage)
calib_complete = False
no_flex_start = 0

# Dynamic thresholds (set by calibration)
thresholds = {
    'NO_FLEX_MIN': 0.5, 'NO_FLEX_MAX': 0.8,
    'MEDIUM_MIN': 0.8, 'MEDIUM_MAX': 1.5,
    'FULL_MIN': 1.5, 'FULL_MAX': 2.5,
    'PID_KP': 0.20, 'PID_KI': 0.05, 'PID_KD': 0.05
}
smoothed_emg = 0.8

# =========================
# GPIO + PWM Setup
# =========================
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()
servo = GPIO.PWM(SERVO_PIN, 50)  # 50Hz servo
servo.start(0)

ser = serial.Serial('/dev/ttyAMA0', 115200, timeout=0.05)

# =========================
# PID Controller
# =========================
class PID:
    def __init__(self, kp, ki, kd, min_out, max_out):
        self.kp, self.ki, self.kd = kp, ki, kd
        self.min_out, self.max_out = min_out, max_out
        self.reset()

    def reset(self):
        self.prev_error = 0
        self.integral = 0
        self.last_time = time.time()

    def update(self, setpoint, measurement):
        current_time = time.time()
        dt = current_time - self.last_time
        if dt <= 0: return 0
        
        error = setpoint - measurement
        self.integral += error * dt
        self.integral = max(-10, min(10, self.integral))  # Anti-windup
        
        P = self.kp * error
        I = self.ki * self.integral
        D = self.kd * (error - self.prev_error) / dt
        
        output = P + I + D
        output = max(self.min_out, min(self.max_out, output))
        
        self.prev_error = error
        self.last_time = current_time
        return output

# =========================
# Servo angle mapping (0-180°)
# =========================
def angle_to_duty(angle):
    angle = max(0, min(180, angle))
    return 2.5 + (10.0 - 2.5) * (angle / 180.0)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# 20s Calibration (5s relax + 10s medium + 5s full)
# =========================
def process_calibration():
    """Calculate 3-phase thresholds"""
    global thresholds, calib_complete
    
    no_flex_data = [v for ts, v in emg_data if no_flex_start <= ts < no_flex_start + 5]
    medium_data = [v for ts, v in emg_data if no_flex_start + 5 <= ts < no_flex_start + 15]
    full_data = [v for ts, v in emg_data if no_flex_start + 15 <= ts < no_flex_start + 20]
    
    if no_flex_data: 
        thresholds['NO_FLEX_MIN'] = np.min(no_flex_data) - 0.05
        thresholds['NO_FLEX_MAX'] = np.max(no_flex_data) + 0.05
    if medium_data:
        thresholds['MEDIUM_MIN'] = np.min(medium_data) - 0.05
        thresholds['MEDIUM_MAX'] = np.max(medium_data) + 0.05
    if full_data:
        thresholds['FULL_MIN'] = np.min(full_data) - 0.05
        thresholds['FULL_MAX'] = np.max(full_data) + 0.20  # Wider for max effort
        
    print("\n" + "="*70)
    print("✅ 20s CALIBRATION COMPLETE")
    print("="*70)
    print(f"RELAX:     {thresholds['NO_FLEX_MIN']:5.2f}V ↔ {thresholds['NO_FLEX_MAX']:5.2f}V")
    print(f"MEDIUM:    {thresholds['MEDIUM_MIN']:5.2f}V ↔ {thresholds['MEDIUM_MAX']:5.2f}V") 
    print(f"FULL:      {thresholds['FULL_MIN']:5.2f}V ↔ {thresholds['FULL_MAX']:5.2f}V")
    print("="*70)
    calib_complete = True

# =========================
# Buzzer
# =========================
def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

def play_calib_sequence():
    for _ in range(3):
        short_beep(0.1, 1500)
        time.sleep(0.1)
    time.sleep(0.5)
    short_beep(0.5, 1000)

# =========================
# EMG UART Reader Thread
# =========================
def uart_reader():
    global emg_data, calibrating
    while running:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith("EMG:"):
                    voltage = float(line.split(":")[1].split("V")[0])
                    ts = time.time()
                    
                    if calibrating:
                        emg_data.append((ts, voltage))
                    
                    print(f"EMG: {voltage:.2f}V", end='\r')
        except:
            pass
        time.sleep(0.01)

# =========================
# Main EMG PID Loop
# =========================
def emg_pid_thread():
    global smoothed_emg, pid_enabled
    
    # PID uses full range as setpoint
    pid_controller = PID(thresholds['PID_KP'], thresholds['PID_KI'], thresholds['PID_KD'],
                        thresholds['NO_FLEX_MIN'], thresholds['FULL_MAX'])
    
    while running:
        switch_state = GPIO.input(SWITCH_PIN)
        pid_enabled = switch_state
        
        if pid_enabled and calib_complete:
            try:
                # Get latest EMG (simplified for thread)
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith("EMG:"):
                    raw_emg = float(line.split(":")[1].split("V")[0])
                    
                    # Smooth
                    alpha = 0.1
                    smoothed_emg = alpha * raw_emg + (1 - alpha) * smoothed_emg
                    
                    # PID tracks to FULL_MAX (clench = max servo)
                    adjustment = pid_controller.update(thresholds['FULL_MAX'], smoothed_emg)
                    target_emg = smoothed_emg + adjustment
                    target_emg = max(thresholds['NO_FLEX_MIN'], min(thresholds['FULL_MAX'], target_emg))
                    
                    # Map to servo 0-180°
                    angle = int((target_emg - thresholds['NO_FLEX_MIN']) / 
                               (thresholds['FULL_MAX'] - thresholds['NO_FLEX_MIN']) * 180)
                    servo_set_angle(angle)
                    
                    print(f"EMG:{raw_emg:.2f}S:{smoothed_emg:.2f} PID:{adjustment:.2f}°{angle}", end='\r')
                    
            except:
                pass
        else:
            servo_set_angle(0)
            if hasattr(pid_controller, 'reset'): pid_controller.reset()
        
        time.sleep(0.02)

# =========================
# MAIN
# =========================
try:
    print("EMG PID Servo v1.5 | Button=Calib | Switch=PID")
    threading.Thread(target=uart_reader, daemon=True).start()
    
    last_button = 1
    while True:
        button = GPIO.input(BUTTON_PIN)
        
        # Button press: Start 20s calibration
        if last_button == 1 and button == 0:
            if not calibrating and not calib_complete:
                calibrating = True
                calib_complete = False
                calibration_start_time = time.time()
                emg_data.clear()
                no_flex_start = calibration_start_time
                play_calib_sequence()
                print("\n🚀 20s CALIBRATION: 0-5s RELAX → 5-15s MEDIUM → 15-20s FULL!")
            
            elif calib_complete:
                print("\n🔄 Recalibrate? Press again.")
        
        # Progress display
        if calibrating:
            elapsed = time.time() - calibration_start_time
            if elapsed >= 20.0:
                calibrating = False
                process_calibration()
            else:
                phase = "RELAX" if elapsed < 5 else "MEDIUM" if elapsed < 15 else "FULL"
                print(f"Calib: {elapsed:.1f}s [{phase}]", end='\r')
        
        last_button = button
        time.sleep(0.05)

except KeyboardInterrupt:
    print("\nShutdown...")
finally:
    running = False
    time.sleep(0.5)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
