#version 1.4 - EMG VOLTAGE → SERVO POSITION ONLY
import RPi.GPIO as GPIO
import time
import serial
import threading

# Pins
SWITCH_PIN = 27
BUTTON_PIN = 22
BUZZER_PIN = 26
SERVO_PIN  = 18

Calibration_Flag = False
running = True

# GPIO setup
GPIO.setmode(GPIO.BCM)
GPIO.setup(SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUZZER_PIN, GPIO.OUT)
GPIO.setup(SERVO_PIN, GPIO.OUT)

buzzer = GPIO.PWM(BUZZER_PIN, 440)
buzzer.stop()

servo = GPIO.PWM(SERVO_PIN, 50)
servo.start(0)

ser = serial.Serial('/dev/ttyAMA0', 115200)

# =========================
# HS-311 SERVO FUNCTIONS (conservative pulse range)
# =========================
def angle_to_duty(angle):
    """Hitec HS-311: safer 900–2100μs range"""
    angle = max(0, min(180, angle))
    pulse_us = 900 + (2100-900) * (angle / 180)
    return round((pulse_us / 20000) * 100, 2)

def servo_set_angle(angle):
    duty = angle_to_duty(angle)
    servo.ChangeDutyCycle(duty)

# =========================
# EMG → ANGLE MAPPING
# =========================
def voltage_to_angle(voltage):
    """Map EMG voltage to servo angle: 1.0V→0°, 1.4V→90°, 2.0V→145°"""
    if voltage <= 1.0:
        return 0
    elif voltage >= 2.0:
        return 145
    else:
        # Linear interpolation between points
        if voltage <= 1.4:
            return int(0 + (90 - 0) * (voltage - 1.0) / (1.4 - 1.0))
        else:
            return int(90 + (145 - 90) * (voltage - 1.4) / (2.0 - 1.4))

# =========================
# STARTUP TESTS
# =========================
print("🧪 HS-311 servo startup test...")
for angle in [0, 45, 90, 135, 180, 90, 0]:
    print(f"  {angle}°")
    servo_set_angle(angle)
    time.sleep(1)
print("EMG Servo Control Ready! (No oscillation)")

# Buzzer/melody (unchanged)
NOTE_E5=659;NOTE_D5=587;NOTE_FS4=370;NOTE_GS4=415
NOTE_CS5=554;NOTE_B4=494;NOTE_D4=294;NOTE_E4=330
NOTE_A4=440;NOTE_CS4=277

melody = [NOTE_E5,NOTE_D5,NOTE_FS4,NOTE_GS4,NOTE_CS5,NOTE_B4,NOTE_D4,NOTE_E4,NOTE_B4,NOTE_A4,NOTE_CS4,NOTE_E4,NOTE_A4]
durations = [8,8,4,4,8,8,4,4,8,8,4,4,2]

def play_note(freq, duration_s):
    if freq <= 0: 
        buzzer.stop(); time.sleep(duration_s); return
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration_s * 0.9)
    buzzer.stop()
    time.sleep(duration_s * 0.1)

def play_melody():
    for i,d in enumerate(durations):
        play_note(melody[i], 1000/d/1000)

def short_beep(duration=0.1, freq=2000):
    buzzer.ChangeFrequency(freq)
    buzzer.start(50)
    time.sleep(duration)
    buzzer.stop()

# EMG Thread ONLY (no oscillator)
def uart_reader():
    global running
    while running:
        try:
            line = ser.readline().decode().strip()
            if line:
                try:
                    emg_voltage = float(line)
                    target_angle = voltage_to_angle(emg_voltage)
                    print(f"EMG: {emg_voltage:.2f}V → {target_angle}°")
                    servo_set_angle(target_angle)
                except ValueError:
                    print("EMG (non-numeric):", line)
        except:
            pass

# Main
try:
    print("EMG Servo Control: Button=Melody | Serial EMG=POSITION ONLY")
    threading.Thread(target=uart_reader, daemon=True).start()

    last_button = GPIO.input(BUTTON_PIN)
    while True:
        button_pressed = GPIO.input(BUTTON_PIN) == 0

        if last_button == 1 and GPIO.input(BUTTON_PIN) == 0:
            Calibration_Flag = True
            print(f"\n🎵 Flag={Calibration_Flag}")
            short_beep(0.1, 2500)
            play_melody()

        last_button = GPIO.input(BUTTON_PIN)
        print(f"B:{'P' if button_pressed else '-'} F:{Calibration_Flag} | EMG controls servo", end='\r')
        time.sleep(0.02)

except KeyboardInterrupt: pass
finally:
    running = False
    servo.ChangeDutyCycle(0)
    time.sleep(0.5)
    servo.stop()
    buzzer.stop()
    GPIO.cleanup()
    ser.close()
    print("\nDone!")
